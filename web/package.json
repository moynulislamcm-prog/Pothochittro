{
  "name": "pothochittro-web",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "পথচিত্র — বাংলাদেশের ৬৪ জেলার মানচিত্র, গন্তব্য ও নিজের ভ্রমণতালিকা",
  "scripts": {
    "dev": "vite",
    "build": "node ../scripts/build-seo.mjs && vite build && node ../scripts/prerender.mjs",
    "preview": "vite preview",
    "smoke": "vite build --ssr smoke/entry.jsx --outDir .smoke --emptyOutDir --logLevel warn && node smoke/run.mjs",
    "build:seo": "node ../scripts/build-seo.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "leaflet": "^1.9.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.0",
    "bangladesh-geo-data": "^4.0.9",
    "bd-geojson": "^1.0.5",
    "jsdom": "^30.1.3",
    "simplify-js": "^1.2.4",
    "vite": "^6.3.5"
  }
}
